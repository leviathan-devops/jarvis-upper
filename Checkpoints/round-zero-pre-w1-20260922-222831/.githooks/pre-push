#!/usr/bin/env bash
# pre-push — local early-deny for the protected branch.
# main is protected by the ruleset (later wave); this refuses the push
# locally before it ever reaches the remote.
# Has no --no-verify escape; fires on push only.
#
# INPUT: $1 = remote name, $2 = remote url; stdin lines:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
set -uo pipefail

while read -r local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo 'REJECT: direct pushes to main are not permitted; open a PR.' >&2
    exit 1
  fi
done

exit 0
