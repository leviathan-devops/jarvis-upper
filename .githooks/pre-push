#!/usr/bin/env bash
# GATE W-2 — reachability
# JEV COUNT: 26   (the measured occurrences in the 298-file corpus)
# ARTIFACT CLASS: the pushed commit range's src tree
# SURFACE: pre-push
# PREDICATE READS: the pushed commit range's src tree — NEVER prose
#
# pre-push — local early-deny for the protected branch.
#
# CHECK 1: main is protected by the ruleset (later wave); this refuses the push
# locally before it ever reaches the remote. Has no --no-verify escape.
#
# CHECK 2 (W-2 reachability, Jev 26): every src/**/*.ts module in the pushed
# range must have at least ONE non-test reference (a file under src/, scripts/,
# gates/, or bin/ that names the module's stem). A module with zero non-test
# callers is an orphan — proof that the module is built but unreachable.
# Derived from gates/orphan_scan.sh's scan() function.
#
# INPUT: $1 = remote name, $2 = remote url; stdin lines:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
set -uo pipefail

source "$(dirname "$0")/lib/pattern-header.sh" 2>/dev/null || true

REMOTE="${1:-}"
REMOTE_URL="${2:-}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# --- CHECK 1: refuse direct pushes to main ---
while read -r local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo 'REJECT: direct pushes to main are not permitted; open a PR.' >&2
    exit 1
  fi
done

# --- CHECK 2: W-2 reachability gate ---
# Only applies when pushing to a non-main ref (i.e., a PR branch).
# For each src/**/*.ts in the pushed range, check it has at least one
# non-test reference. Derived from gates/orphan_scan.sh scan().
#
# Strategy: find files changed in the push range, filter to src/**/*.ts,
# then for each, grep for its stem across src/ scripts/ gates/ bin/.

# Re-read stdin for the push range — we need the local-sha.
# stdin was already consumed above; git passes it as <local-sha> <remote-sha>.
# We reconstruct from local_ref / _local_sha captured in the first pass.
# Actually, we must re-read — but stdin is consumed. Instead, use git diff
# against the remote-tracking branch.

# Collect src/**/*.ts touched between remote-tracking branch and local.
# We need the remote-tracking ref name from the push info.
# Since we re-read stdin above and discarded it, we use git for-each-ref
# to find the tracking branch. Alternatively, accept the local-sha from
# the while loop above by capturing it.

# Correct approach: capture local_sha in the first pass.
PUSHED_SHA=""
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$local_ref" != "DELETE" ] && [ "$local_ref" != "" ]; then
    PUSHED_SHA="${local_sha}"
    break
  fi
done

# If no pushed sha, nothing to check (force push / tag / delete).
[ -z "$PUSHED_SHA" ] && exit 0

# Find the merge-base with any remote-tracking branch to get the diff range.
# Use git diff --name-only against the remote branch.
REMOTE_BRANCH=$(git for-each-ref --format='%(refname:short)' refs/remotes/ 2>/dev/null | head -1)
if [ -n "$REMOTE_BRANCH" ]; then
  RANGE="${REMOTE_BRANCH}..${PUSHED_SHA}"
else
  # No remote branch — use root.
  RANGE="--root ${PUSHED_SHA}"
fi

# Get the list of src/**/*.ts files in this push range.
CHANGED_SRC=$(git diff --name-only --diff-filter=ACM $RANGE 2>/dev/null | grep '^src/.*\.ts$' || true)

# If no src files changed, nothing to gate.
[ -z "$CHANGED_SRC" ] && exit 0

FAIL=0

for f in $CHANGED_SRC; do
  # Skip non-files.
  [ -e "$f" ] || continue

  BASENAME=$(basename "$f" .ts)

  # Skip known entry points (derived from gates/orphan_scan.sh).
  case "$BASENAME" in
    main|runtime|cli|status) continue ;;
  esac

  # Count non-test references: any .ts/.js/.sh/.json file under src/ scripts/
  # gates/ bin/ that names the module stem, excluding the file itself and tests/.
  REFS=$(grep -rln --include='*.ts' --include='*.js' --include='*.sh' --include='*.json' \
         -- "$BASENAME" src/ scripts/ gates/ bin/ 2>/dev/null \
         | grep -v "^$f$" | grep -v '^tests' | wc -l | tr -d ' ')

  if [ "$REFS" = "0" ]; then
    printf 'REJECT(W-2): ORPHAN:%s (0 non-test callers)\n' "$f" >&2
    FAIL=1
  fi
done

[ "$FAIL" -eq 1 ] && exit 1

exit 0
