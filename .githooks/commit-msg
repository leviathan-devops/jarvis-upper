#!/usr/bin/env bash
# commit-msg — the BYPASSABLE twin of prepare-commit-msg.
#
# Same two checks (semantic prefix + W-8 claim-evidence), on $1.
# Kept because this is the conventional location and it fires for
# `git merge`. Unlike prepare-commit-msg, this hook CAN be bypassed
# with --no-verify; prepare-commit-msg is the absolute anchor.
set -uo pipefail

MSG_FILE="${1:?usage: commit-msg <msg-file>}"

MSG="$(grep -v '^#' "$MSG_FILE" 2>/dev/null || true)"

if [ -z "$(printf '%s' "$MSG" | tr -d '[:space:]')" ]; then
  exit 0
fi

# CHECK 1 — the semantic prefix.
if ! printf '%s' "$MSG" | grep -qE '^(feat|fix|docs|test|build|refactor|blueprint|goal|chore|spec|perf)(\([^)]+\))?: '; then
  echo 'REJECT(W-8): message lacks semantic prefix ^(feat|fix|docs|test|build|refactor|blueprint|goal|chore|spec|perf)(scope)?: ' >&2
  exit 1
fi

# CHECK 2 — the claim-evidence rule (W-8).
if printf '%s' "$MSG" | grep -qiE 'verified|passed|tested|works|green'; then
  HAS_EVIDENCE=0
  printf '%s' "$MSG" | grep -qE '[0-9]+ (pass|tests)' && HAS_EVIDENCE=1
  printf '%s' "$MSG" | grep -qE '[a-f0-9]{7,}' && HAS_EVIDENCE=1
  printf '%s' "$MSG" | grep -qE '[a-z-]+\.(ts|md|sh|yml):[0-9]+' && HAS_EVIDENCE=1
  if [ "$HAS_EVIDENCE" -eq 0 ]; then
    echo 'REJECT(W-8): claim word (verified|passed|tested|works|green) with no artifact; include a test count ("N pass"/"N tests"), a sha ([a-f0-9]{7,}), or a file:line (path.ext:NN)' >&2
    exit 1
  fi
fi

exit 0
