# runtime state (regenerated every tick) — never a source artifact
runtime/status.json
runtime/ticks.log
runtime/wire_capture.json
runtime/watchdog-ledger.jsonl
# MULTI-PROJECT: each project writes runtime/<id>/{status.json,ticks.log,wire_capture.json,store.sqlite}.
# Live state is NEVER tracked — it would dirty the tree on every 15s tick and make every commit
# carry a state churn instead of a semantic change.
runtime/**
store.sqlite
store.sqlite-wal
store.sqlite-shm
node_modules/
dist/
# the JAM/JFM desk tracker: LIVE state (jfm writes it on every verb) — never source
.omp-waves/
**/__pycache__/
*.py[cod]

# THE GENERATED RECORDS (a 646-file checkpoint diff is NOT reviewable code —
# the W-9 gate's own artifact-class law: a snapshot/working-state is machine-
# generated, exempt from the doc law, and likewise from the diff budget).
Checkpoints/
.trident/
.aider.chat.history.md

# KICK DOSSIERS: machine-generated per-bug working artifacts (writeDossier),
# the same class as .trident/ — never source, never shipped.
/dossiers/
